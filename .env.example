# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Browser-safe (exposed to the client bundle) — Supabase project URL and anon/public key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — Supabase service-role key. Bypasses Row Level Security.
# Used only in trusted server-side code (lib/supabase/admin.ts). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — base URL the app uses to build absolute links for server-side
# processes that can't infer it from an incoming request (e.g. the headless
# PDF-export renderer). Defaults to http://localhost:3000 in development.
# Set to the production URL (e.g. https://app.financialhealthplatform.com) in deployed environments.
APP_BASE_URL=

# Server-only secret — bearer token required by the scheduled monthly report
# generation endpoint (app/api/reports/cron/monthly-generate). Generate a long
# random value and configure the same value on whatever scheduler calls this endpoint.
CRON_SECRET=

# Server-only secret — Resend API key (Sending access, scoped to a verified
# domain) used by app/api/contact/route.ts to email a notification when the
# public /contact form is submitted. Without this set, submissions are still
# saved to contact_submissions but no email is sent (see the route's
# sendContactNotification()).
RESEND_API_KEY=

# Server-only — sender address for contact-form notification emails. Must be
# on a domain verified in Resend. Defaults to
# "FHIP Contact Form <no-reply@auth.financialhealthplatform.com>" if unset.
CONTACT_FROM_EMAIL=

# Server-only — G4 Application-Wide Capability Layer feature flag
# (lib/services/appCapabilityFlag.ts). Must be the exact string "true" to
# enable; unset or any other value keeps the pre-G4 (G3) containment
# behaviour with no data changes either way. Not for production use yet.
G4_APP_CAPABILITY_LAYER_ENABLED=

# LR-10 — payment providers. Stripe serves AU (and any future PO-approved
# Global region); Razorpay serves India. ALL of the following are
# server-only secrets — never NEXT_PUBLIC_*, never logged, never committed.
# Leaving any of these unset keeps that provider's checkout/webhook routes
# in a safe "not configured" state (a clear 503, never a crash or a silent
# fallback to a fabricated price) — see lib/services/payments/*Client.ts.
#
# WP-12 (activation control): use TEST-mode keys in DEV and LIVE-mode keys
# in production — never the same key in both. Stripe/Razorpay test and live
# keys are visually distinguishable by their own prefixes (sk_test_/sk_live_,
# rzp_test_/rzp_live_) — see tests/unit/paymentActivationControl.test.ts for
# the automated check that a live-looking key is never used with
# NODE_ENV!=production and vice versa.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM_MONTHLY_AU=
STRIPE_PRICE_ID_PREMIUM_ANNUAL_AU=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PREMIUM_MONTHLY_IN=
RAZORPAY_PLAN_ID_PREMIUM_ANNUAL_IN=

# ---------------------------------------------------------------------------
# AI Extraction Engine (AIE-1) — added by M12C section 13 (M2-OPEN-4).
#
# Every variable below is SERVER-ONLY. There is no NEXT_PUBLIC_AIE_* variable
# and there must never be one: two of these are genuine secrets, and the flags
# gate canonical database writes, so a browser copy of any of them would be
# either a credential leak or a client-side override of a server-side write
# gate. tests/unit/m12cServerOnlySecretBoundary.test.ts enforces both halves.
#
# No real value is recorded here, as everywhere else in this file.
# ---------------------------------------------------------------------------

# SECRET. The AIE gateway's own OpenAI credential (distinct from any Module 11
# key). providerFactory.ts throws rather than silently falling back to the mock
# provider when this is unset, so a misconfiguration fails loudly.
AIE_OPENAI_API_KEY=

# SECRET. 32 bytes / 64 hex characters. Master secret for the ONE-WAY HMAC that
# derives [MASKED:...] identifier tokens. There is no reversible token map
# anywhere in the product — this key derives tokens, it never decrypts them.
# Masking fails CLOSED when it is unset (maskText throws; the orchestrator
# degrades the run to reconciliation rather than crashing the request), so an
# absent value is safe-but-degraded, never silently permissive.
AIE_MASK_TOKEN_ENCRYPTION_KEY=

# Not secrets — feature flags, cohort gating and tuning. Each flag file owns
# its own default and fail-closed behaviour; see lib/aie/featureFlags.ts,
# lib/aie/config.ts, lib/aie/review/featureFlags.ts and the three adapter
# featureFlags.ts files. Those defaults are deliberately NOT restated here,
# because a restatement drifts — but the NAMES are exhaustive, and
# tests/unit/m12cServerOnlySecretBoundary.test.ts fails if the code ever reads
# an AIE_* name this file does not declare.
AIE_DOCUMENT_INTAKE_ENABLED=
AIE_AI_FALLBACK_ENABLED=
AIE_AI_PROVIDER=
AIE_AI_MODEL=
AIE_AI_TIMEOUT_MS=
AIE_AI_MAX_TRANSIENT_RETRIES=
AIE_AI_MAX_INPUT_TOKENS=
AIE_AI_MAX_OUTPUT_TOKENS=
AIE_AI_COST_ALLOWANCE_USD=
AIE_ALLOW_MISSING_SIGNATURE_SCANNER=
# Real-malware-gate wiring (2026-09-21) -- shared S3 + GuardDuty Malware
# Protection gate for BOTH the AIE and FDH-3 upload pipelines. Shipped
# DEV-only/disabled: AIE_REAL_MALWARE_SCAN_ENABLED must be 'true' AND every
# AWS setting below must be set, or the gate reports scan_failed (fail
# closed) rather than silently running structural-validation-only.
#
# 2026-09-21 production-activation fix: credential var names changed from
# the plain AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN to the
# AIE_MALWARE_AWS_* names below. The plain names are still read as a
# fallback (existing tests/local setups keep working), but the AIE_-prefixed
# names are strongly preferred in any real deployment: (1) this repo's
# amplify.yml only forwards server-only env vars into the Next.js runtime
# via an explicit prefix allowlist, and the AIE_ prefix is already on it --
# no amplify.yml change needed; (2) Amplify Hosting's CodeBuild-based build
# containers commonly export their OWN temporary build-role credentials
# under the plain AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY names, so setting
# a console value with the same name risks silently colliding with (or being
# shadowed by) the build's own short-lived credential instead of this app's.
AIE_REAL_MALWARE_SCAN_ENABLED=
AIE_MALWARE_S3_BUCKET=
AIE_MALWARE_S3_REGION=
AIE_MALWARE_S3_ACCOUNT_ID=
AIE_MALWARE_AWS_ACCESS_KEY_ID=
AIE_MALWARE_AWS_SECRET_ACCESS_KEY=
AIE_MALWARE_AWS_SESSION_TOKEN=
AIE_MALWARE_SCAN_ADMISSION_WINDOW_MINUTES=
AIE_PILOT_COHORT_ENFORCED=
AIE_PILOT_COHORT_EMAILS=
AIE_PILOT_COHORT_USER_IDS=
AIE_REVIEW_UI_ENABLED=
AIE_REVIEW_BULK_ACTIONS_ENABLED=
AIE_REVIEW_EVIDENCE_REVEAL_ENABLED=
AIE_REVIEW_CANONICAL_ACCEPTANCE_ENABLED=
AIE_REVIEW_PC5_PROJECTION_ENABLED=
AIE_INSURANCE_ADAPTER_ENABLED=
AIE_INSURANCE_ADAPTER_CANONICAL_WRITE_ENABLED=
AIE_FDH_BANK_ADAPTER_ENABLED=
AIE_FDH_BANK_AI_FALLBACK_ENABLED=
AIE_FDH_BANK_ATOMIC_IMPORT_ENABLED=
AIE_II_ADAPTER_ENABLED=
AIE_II_ADAPTER_CANONICAL_WRITE_ENABLED=

# Not secrets. The OLD, pre-AIE Investment Intelligence AI-fallback path
# (lib/services/investment-intelligence/aiFallbackFeatureFlag.ts) — distinct
# from the AIE_* variables above, spelled II_ for "Investment Intelligence".
# 2026-09-21 fix (M13A finding): this path previously had a kill switch but no
# pilot-cohort gate; added here as its own, separately-named cohort, fail
# CLOSED when enforced with an empty allowlist (never silently "everyone
# allowed"), matching the AIE_PILOT_COHORT_* convention above exactly.
II_AI_FALLBACK_ENABLED=
II_AI_FALLBACK_PILOT_COHORT_ENFORCED=
II_AI_FALLBACK_PILOT_COHORT_USER_IDS=
II_AI_FALLBACK_PILOT_COHORT_EMAILS=
