# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Browser-safe (exposed to the client bundle) — Supabase project URL and anon/public key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — Supabase service-role key. Bypasses Row Level Security.
# Used only in trusted server-side code (lib/supabase/admin.ts). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — base URL the app uses to build absolute links for server-side
# processes that can't infer it from an incoming request (e.g. the headless
# PDF-export renderer). Defaults to http://localhost:3000 in development.
# Set to the production URL (e.g. https://app.financialhealthplatform.com) in deployed environments.
APP_BASE_URL=

# Server-only secret — bearer token required by the scheduled monthly report
# generation endpoint (app/api/reports/cron/monthly-generate). Generate a long
# random value and configure the same value on whatever scheduler calls this endpoint.
CRON_SECRET=

# Server-only secret — Resend API key (Sending access, scoped to a verified
# domain) used by app/api/contact/route.ts to email a notification when the
# public /contact form is submitted. Without this set, submissions are still
# saved to contact_submissions but no email is sent (see the route's
# sendContactNotification()).
RESEND_API_KEY=

# Server-only — sender address for contact-form notification emails. Must be
# on a domain verified in Resend. Defaults to
# "FHIP Contact Form <no-reply@auth.financialhealthplatform.com>" if unset.
CONTACT_FROM_EMAIL=

# Server-only — G4 Application-Wide Capability Layer feature flag
# (lib/services/appCapabilityFlag.ts). Must be the exact string "true" to
# enable; unset or any other value keeps the pre-G4 (G3) containment
# behaviour with no data changes either way. Not for production use yet.
G4_APP_CAPABILITY_LAYER_ENABLED=
