{
  "name": "fhip",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "resources:import-r0a": "tsx --env-file=.env.local scripts/resources/import-r0a-content-master.ts",
    "resources:rollback-r0a": "tsx --env-file=.env.local scripts/resources/rollback-r0a.ts",
    "resources:verify-r0a": "tsx --env-file=.env.local scripts/resources/verify-r0a.ts",
    "resources:p0:dry-run": "tsx --env-file=.env.local scripts/resources/p0-content/load-p0-content.ts",
    "resources:p0:apply": "tsx --env-file=.env.local scripts/resources/p0-content/load-p0-content.ts -- --apply",
    "resources:p0:verify": "tsx --env-file=.env.local scripts/resources/p0-content/verify-p0-content.ts",
    "resources:p0:reconcile": "tsx --env-file=.env.local scripts/resources/p0-content/query-cms-reconciliation.ts",
    "resources:p0:related-dry-run": "tsx --env-file=.env.local scripts/resources/p0-content/load-related-content.ts",
    "resources:p0:related-apply": "tsx --env-file=.env.local scripts/resources/p0-content/load-related-content.ts -- --apply",
    "check:migrations": "node scripts/check-migration-versions.mjs",
    "check:migrations:against-main": "node scripts/check-migration-versions-against-branch.mjs --against=origin/main"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^0.446.0",
    "next": "16.2.12",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.25"
    },
    "sharp": "^0.35.3",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
