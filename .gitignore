# R4 UX verification fixture scratch state (contains DEV test-user ids)
scripts/.ii_r4_ux_fixture.json

# FDH-1 closure: generated live-schema evidence artefacts (regenerate with scripts/fdh1_closure_*.mjs)
scripts/.fdh1-*.json
.r17d-reviewer-credentials.local.json

# R7/FDH-4 live-certification scratch: local synthetic fixtures and result
# dumps generated per-run by scripts/r7final_*.mjs and scripts/fdh4_live_*.ts
# — never committed (large, disposable, regenerated per session).
.r7scratch/

# R8 live-certification scratch: local result dumps generated per-run by
# scripts/r8_live_dev_certification.mjs — never committed (disposable,
# regenerated per session, same pattern as .r7scratch above).
.r8scratch/

# II-PC2 live-DEV certification scratch: probe scripts, synthetic-fixture
# builders and result dumps generated per-run — never committed (disposable,
# regenerated per session, same pattern as .r7scratch/.r8scratch above).
.pc2scratch/

# Mandatory Country Confirmation (2026-08-29) — Gate B restricted cleanup
# manifest. scripts/mcc_production_readonly_audit.mjs writes this OUTSIDE
# the repo by default (see MCC_RESTRICTED_MANIFEST_DIR in that script); this
# pattern is defense-in-depth only, in case that default is ever overridden
# to a path inside the repo. Contains exact production auth user ids/emails
# — must never be committed (spec section 7.4).
mcc_restricted_manifest*.json
.mcc-restricted/
